# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/paymesh?retryWrites=true&w=majority

# JWT Secrets & Expiry
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-secure-refresh-jwt-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Optional Redis Cache
REDIS_URL=redis://localhost:6379
